Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Names: true
      Show Arrows: true
    - Class: rviz_default_plugins/Odometry
      Name: cuVSLAM Odometry
      Enabled: true
      Topic:
        Value: /visual_slam/tracking/odometry
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape:
        Value: Axes
    - Class: rviz_default_plugins/Path
      Name: SLAM Path
      Enabled: true
      Topic:
        Value: /visual_slam/tracking/slam_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.03
      Color: 25; 255; 0
    - Class: rviz_default_plugins/Path
      Name: VO Path
      Enabled: true
      Topic:
        Value: /visual_slam/tracking/vo_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.02
      Color: 255; 170; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Landmarks
      Enabled: true
      Topic:
        Value: /visual_slam/vis/landmarks_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (Pixels): 2
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Name: Observations
      Enabled: true
      Topic:
        Value: /visual_slam/vis/observations_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (Pixels): 3
      Style: Points
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
