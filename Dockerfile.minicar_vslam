ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-colcon-common-extensions \
        python3-pytest \
        python3-yaml \
        ros-humble-isaac-ros-visual-slam \
        ros-humble-tf2-tools && \
    version="$(dpkg-query -W -f='${Version}' ros-humble-isaac-ros-visual-slam)" && \
    [[ "${version}" == 3.2.* ]] && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/minicar_vslam_ws
COPY src/minicar_realsense src/minicar_realsense
RUN source /opt/ros/humble/setup.bash && \
    colcon build --merge-install --packages-select minicar_realsense

COPY scripts/vslam_preflight.bash /usr/local/bin/minicar-vslam-preflight
RUN chmod +x /usr/local/bin/minicar-vslam-preflight && \
    printf '%s\n' \
        'source /opt/ros/humble/setup.bash' \
        'source /opt/minicar_vslam_ws/install/local_setup.bash' \
        > /etc/minicar_vslam_setup.bash

ENV BASH_ENV=/etc/minicar_vslam_setup.bash
ENV DEBIAN_FRONTEND=
CMD ["bash"]
