Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Map
      Name: Map (track_v1)
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: map
      Alpha: 0.8
      Value: true
    - Class: rviz_default_plugins/Path
      Name: raceline
      Enabled: true
      Topic:
        Value: /raceline_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color: 138; 137; 132
      Line Style: Lines
      Line Width: 0.02
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: scan_filtered (AMCLの姿勢で描画)
      Enabled: true
      Topic:
        Value: /scan_filtered
        Reliability Policy: Best Effort
        Depth: 5
      Color Transformer: FlatColor
      Color: 227; 73; 72
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: AMCL 粒子
      Enabled: true
      Topic:
        Value: /particle_cloud_poses
        Reliability Policy: Reliable
        Depth: 5
      Shape: Arrow (Flat)
      Color: 74; 58; 167
      Arrow Length: 0.08
      Head Length: 0.02
      Head Radius: 0.015
      Shaft Length: 0.06
      Shaft Radius: 0.005
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: AMCL 自己位置 (/amcl_pose)
      Enabled: true
      Topic:
        Value: /amcl_pose
        Reliability Policy: Reliable
        Depth: 5
      Shape: Arrow
      Color: 42; 120; 214
      Shaft Length: 0.3
      Shaft Radius: 0.03
      Head Length: 0.1
      Head Radius: 0.07
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: 走行時のslam_toolbox (/slam_pose)
      Enabled: true
      Topic:
        Value: /slam_pose
        Reliability Policy: Reliable
        Depth: 5
      Shape: Arrow
      Color: 235; 104; 52
      Shaft Length: 0.3
      Shaft Radius: 0.03
      Head Length: 0.1
      Head Radius: 0.07
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Frames:
        All Enabled: false
        base_link:
          Value: true
        laser_frame:
          Value: false
        map:
          Value: true
        odom:
          Value: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 90
      X: -1
      Y: 2
      Angle: 0
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
